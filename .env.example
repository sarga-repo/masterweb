# PostgreSQL local development values
POSTGRES_DB=sarga_strapi
POSTGRES_USER=sarga
POSTGRES_PASSWORD=sarga_local_password

# Seed demo content + public read permissions on Strapi startup (local only).
# Idempotent: records are created only when the content types are empty.
# Set to false (or remove) for any shared, staging, or production environment.
SEED_DEMO_CONTENT=true

# Strapi local development placeholders; replace for any shared environment.
STRAPI_APP_KEYS=change_me_1,change_me_2,change_me_3,change_me_4
STRAPI_API_TOKEN_SALT=change_me_api_token_salt
STRAPI_ADMIN_JWT_SECRET=change_me_admin_jwt_secret
STRAPI_TRANSFER_TOKEN_SALT=change_me_transfer_token_salt
STRAPI_JWT_SECRET=change_me_jwt_secret
STRAPI_ENCRYPTION_KEY=change_me_encryption_key

# Frontend URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sarga Motorsport site URL — used by the gateway to link to the motorsport frontend.
NEXT_PUBLIC_MOTORSPORT_SITE_URL=http://localhost:3001
# Sarga Horse Sport site URL — used by the gateway/motorsport to link to the horse sport frontend.
NEXT_PUBLIC_HORSESPORT_SITE_URL=http://localhost:3002
# Link from dedicated frontends back to the Sarga.co group gateway.
NEXT_PUBLIC_GATEWAY_SITE_URL=http://localhost:3000
# Identifies this frontend to the shared CMS (siteScope / Site slug).
NEXT_PUBLIC_SITE_KEY=sarga-motorsport
# Optional local or CDN WebM/MP4 loop for true hero subject motion. The static
# CMS hero image remains the poster and reduced-motion fallback.
NEXT_PUBLIC_HERO_VIDEO_URL=
# Browser-reachable Strapi URL (used to build absolute media/image URLs).
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
# Server-side Strapi URL used for content fetching. In Docker Compose this is
# overridden to http://strapi:1337 (see docker-compose.yml).
STRAPI_API_URL=http://localhost:1337
# Legacy/alternate server-side URL; kept as a fallback for existing setups.
STRAPI_API_URL_INTERNAL=http://strapi:1337

# Read-only frontend API token. Server-only — never exposed to the browser.
# Leave blank until a read-only token is created in Strapi; the frontend then
# falls back to bundled mock content.
STRAPI_API_TOKEN=

# Form delivery. `placeholder` is for local UI/UAT only: it validates and
# returns success without retaining personal data. Use `strapi` in production
# with a server-only token that can create inquiry/newsletter records.
FORM_SUBMISSION_MODE=placeholder

# Optional reCAPTCHA verification integration point. Configure only after an
# approved client token adapter is installed.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Explicit allowlists for partner app links and iframe embeds.
TICKETING_DEEP_LINK_SCHEMES=
TICKETING_EMBED_ALLOWLIST=
