HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
# Set true only when Strapi is behind a trusted reverse proxy such as Nginx.
PROXY_KOA=false

# Local host development uses the Docker-exposed PostgreSQL port.
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=sarga_strapi
DATABASE_USERNAME=sarga
DATABASE_PASSWORD=sarga_local_password
DATABASE_SSL=false

# Strapi bootstrap keeps English (en) as default and creates Indonesian (id)
# when missing. Locale create/update/delete remains a Super Admin operation.
# Optional isolated i18n rehearsal helper variables (never use the source name
# as the rehearsal name):
POSTGRES_CONTAINER=sarga-postgres-local
SOURCE_DATABASE_NAME=sarga_strapi
REHEARSAL_DATABASE_NAME=sarga_strapi_i18n_rehearsal
I18N_REHEARSAL_ARTIFACT_DIR=/tmp/sarga-gwr-cms-5

# Replace every placeholder with a long, unique value outside local development.
APP_KEYS=change_me_1,change_me_2,change_me_3,change_me_4
API_TOKEN_SALT=change_me_api_token_salt
ADMIN_JWT_SECRET=change_me_admin_jwt_secret
TRANSFER_TOKEN_SALT=change_me_transfer_token_salt
JWT_SECRET=change_me_jwt_secret
ENCRYPTION_KEY=change_me_encryption_key

# Seed local demo content + public read permissions on startup (local only).
SEED_DEMO_CONTENT=true

# Exchange Online outbound transport (GWR-CMS-MAIL-2/4.1).
# Keep disabled for local development. Never commit a mailbox password; the
# blank fallback variable below is populated only in the protected VM runtime.
MAIL_ENABLED=false
MAIL_AUTH_MODE=oauth
MAIL_SMTP_HOST=smtp.office365.com
MAIL_SMTP_PORT=587
MAIL_SMTP_REQUIRE_TLS=true
MAIL_SMTP_USER=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sarga
MAIL_DEFAULT_REPLY_TO=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SMTP_SCOPE=https://outlook.office365.com/.default
# Emergency existing-tenant fallback only. Never commit a real password.
MAIL_SMTP_PASSWORD=
MAIL_BASIC_AUTH_ACKNOWLEDGED=
MAIL_BASIC_AUTH_EXPIRES_AT=
MAIL_NOTIFICATIONS_ENABLED=false
MAIL_RECIPIENT_GATEWAY=
MAIL_RECIPIENT_MOTORSPORT=
MAIL_RECIPIENT_HORSESPORT=
MAIL_MAX_ATTEMPTS=5
MAIL_WORKER_BATCH_SIZE=10
MAIL_WORKER_CRON="*/1 * * * *"

# Optional one-time provisioning for site-segregated Strapi admin accounts.
# Use unique production secrets (8-72 bytes with upper/lowercase letters and a number).
# Remove each EMAIL/PASSWORD pair from the runtime environment after its account is created;
# existing users are never reassigned or password-reset automatically.
CMS_GATEWAY_ADMIN_EMAIL=
CMS_GATEWAY_ADMIN_PASSWORD=
CMS_GATEWAY_ADMIN_FIRSTNAME=Sarga
CMS_GATEWAY_ADMIN_LASTNAME=Gateway

CMS_MOTORSPORT_ADMIN_EMAIL=
CMS_MOTORSPORT_ADMIN_PASSWORD=
CMS_MOTORSPORT_ADMIN_FIRSTNAME=Sarga
CMS_MOTORSPORT_ADMIN_LASTNAME=Motorsport

CMS_HORSESPORT_ADMIN_EMAIL=
CMS_HORSESPORT_ADMIN_PASSWORD=
CMS_HORSESPORT_ADMIN_FIRSTNAME=Sarga
CMS_HORSESPORT_ADMIN_LASTNAME=Horse Sport

CMS_SHARED_ADMIN_EMAIL=
CMS_SHARED_ADMIN_PASSWORD=
CMS_SHARED_ADMIN_FIRSTNAME=Sarga
CMS_SHARED_ADMIN_LASTNAME=Shared Library
