{
  "kind": "collectionType",
  "collectionName": "corporate_reports",
  "info": {
    "singularName": "corporate-report",
    "pluralName": "corporate-reports",
    "displayName": "Corporate Report",
    "description": "Approved annual and sustainability report library entries"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "reportType": {
      "type": "enumeration",
      "enum": ["annual", "sustainability"],
      "required": true
    },
    "year": { "type": "integer", "required": true },
    "summary": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "reportFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "externalUrl": { "type": "string" },
    "publicationStatus": {
      "type": "enumeration",
      "enum": ["published", "forthcoming", "archived"],
      "default": "forthcoming",
      "required": true
    },
    "publishedDate": { "type": "date" },
    "order": { "type": "integer", "default": 0 },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "shared", "hidden"],
      "default": "gateway",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
