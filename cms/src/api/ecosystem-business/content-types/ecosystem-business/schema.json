{
  "kind": "collectionType",
  "collectionName": "ecosystem_businesses",
  "info": {
    "singularName": "ecosystem-business",
    "pluralName": "ecosystem-businesses",
    "displayName": "Ecosystem Business",
    "description": "A Sarga business or intellectual property"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "pillar": {
      "type": "enumeration",
      "enum": ["sports", "venue", "media", "technology", "festival", "other"],
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "overview": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "highlights": {
      "type": "component",
      "component": "shared.key-highlight",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "cardImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "ctaLabel": {
      "type": "string",
      "default": "Find Out More",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ctaUrl": { "type": "string" },
    "businessStatus": {
      "type": "enumeration",
      "enum": ["active", "comingSoon", "hidden"],
      "default": "active",
      "required": true
    },
    "launchTarget": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "pageAvailability": {
      "type": "component",
      "component": "shared.page-availability",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "order": { "type": "integer", "default": 0 },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "shared",
      "required": true
    },
    "dedicatedSiteKey": {
      "type": "enumeration",
      "enum": ["none", "motorsport", "horsesport"],
      "default": "none"
    },
    "dedicatedSiteUrl": { "type": "string" },
    "relatedArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::news-article.news-article",
      "mappedBy": "relatedBusinesses"
    },
    "relatedEvents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event",
      "mappedBy": "business"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
