{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Live events and approved partner ticket destinations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "eventDate": { "type": "datetime" },
    "endDate": { "type": "datetime" },
    "venue": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "business": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ecosystem-business.ecosystem-business",
      "inversedBy": "relatedEvents"
    },
    "ticketCtaLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ticketUrl": { "type": "string" },
    "ticketIntegrationType": {
      "type": "enumeration",
      "enum": ["redirect", "deepLink", "embed"],
      "default": "redirect"
    },
    "embedCode": { "type": "text", "private": true },
    "embedUrl": { "type": "string" },
    "eventStatus": {
      "type": "enumeration",
      "enum": [
        "upcoming",
        "live",
        "past",
        "hidden",
        "announced",
        "ticketsOpen",
        "soldOut",
        "completed",
        "cancelled"
      ],
      "default": "upcoming",
      "required": true
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "gateway",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "showOnGateway": { "type": "boolean", "default": true },
    "showOnMotorsport": { "type": "boolean", "default": false },
    "showOnHorseSport": { "type": "boolean", "default": false },
    "racingCategory": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seriesName": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "venueAddress": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "circuitName": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "schedule": {
      "type": "component",
      "component": "shared.event-session",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "broadcastUrl": { "type": "string" },
    "eventDiscipline": {
      "type": "enumeration",
      "enum": [
        "derby",
        "turf",
        "exhibition",
        "championship",
        "hospitality",
        "training",
        "other"
      ]
    },
    "raceClass": { "type": "string" },
    "trackType": {
      "type": "enumeration",
      "enum": ["turf", "dirt", "mixed", "indoor", "other"]
    },
    "hospitalityInfo": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "stableAccessInfo": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ticketCtas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ticket-cta.ticket-cta",
      "mappedBy": "relatedEvent"
    },
    "sponsors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::partner.partner"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
