{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Live events and approved partner ticket destinations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": { "type": "richtext", "required": true },
    "eventDate": { "type": "datetime" },
    "endDate": { "type": "datetime" },
    "venue": { "type": "string" },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "business": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ecosystem-business.ecosystem-business",
      "inversedBy": "relatedEvents"
    },
    "ticketCtaLabel": { "type": "string" },
    "ticketUrl": { "type": "string" },
    "ticketIntegrationType": {
      "type": "enumeration",
      "enum": ["redirect", "deepLink", "embed"],
      "default": "redirect"
    },
    "embedCode": { "type": "text", "private": true },
    "embedUrl": { "type": "string" },
    "eventStatus": {
      "type": "enumeration",
      "enum": ["upcoming", "live", "past", "hidden"],
      "default": "upcoming",
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
