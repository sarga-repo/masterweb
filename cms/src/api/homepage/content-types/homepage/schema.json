{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Homepage hero, calls to action, and featured content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroEyebrow": { "type": "string", "required": true },
    "heroTitle": { "type": "string", "required": true },
    "heroDescription": { "type": "richtext", "required": true },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "heroImageMobile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "primaryCtaLabel": { "type": "string", "required": true },
    "primaryCtaUrl": { "type": "string", "required": true },
    "secondaryCtaLabel": { "type": "string" },
    "secondaryCtaUrl": { "type": "string" },
    "aboutSummaryTitle": { "type": "string" },
    "aboutSummaryBody": { "type": "richtext" },
    "featuredBusinesses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ecosystem-business.ecosystem-business"
    },
    "featuredArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news-article.news-article"
    },
    "featuredEvents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
