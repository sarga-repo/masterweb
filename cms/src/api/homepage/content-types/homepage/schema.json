{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Homepage hero, calls to action, and featured content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "heroEyebrow": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroDescription": {
      "type": "richtext",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "heroImageMobile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "heroVideo": {
      "type": "component",
      "component": "shared.hero-video",
      "repeatable": false,
      "required": false
    },
    "primaryCtaLabel": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "primaryCtaUrl": { "type": "string", "required": true },
    "secondaryCtaLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "secondaryCtaUrl": { "type": "string" },
    "aboutSummaryTitle": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "aboutSummaryBody": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "featuredBusinesses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ecosystem-business.ecosystem-business"
    },
    "featuredArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news-article.news-article"
    },
    "featuredEvents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
