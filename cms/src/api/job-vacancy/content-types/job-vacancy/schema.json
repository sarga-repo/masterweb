{
  "kind": "collectionType",
  "collectionName": "job_vacancies",
  "info": {
    "singularName": "job-vacancy",
    "pluralName": "job-vacancies",
    "displayName": "Job Vacancy",
    "description": "Gateway careers vacancies with approved LinkedIn application links"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "discipline": {
      "type": "enumeration",
      "enum": [
        "sport-operations",
        "venue-experience",
        "media-creative",
        "technology-group"
      ],
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "richtext",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "responsibilities": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "requirements": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "location": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "employmentType": {
      "type": "enumeration",
      "enum": ["full-time", "part-time", "contract", "internship"],
      "default": "full-time",
      "required": true
    },
    "workMode": {
      "type": "enumeration",
      "enum": ["onsite", "hybrid", "remote"],
      "default": "onsite",
      "required": true
    },
    "seniority": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "applicationUrl": {
      "type": "string",
      "regex": "^https:\\/\\/([a-zA-Z0-9-]+\\.)*linkedin\\.com(?:\\/|$)"
    },
    "vacancyStatus": {
      "type": "enumeration",
      "enum": ["open", "closed", "filled"],
      "default": "open",
      "required": true
    },
    "postedDate": { "type": "date", "required": true },
    "closingDate": { "type": "date" },
    "featured": { "type": "boolean", "default": false },
    "order": { "type": "integer", "default": 0 },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "shared", "hidden"],
      "default": "gateway",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
