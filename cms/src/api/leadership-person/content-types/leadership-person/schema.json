{
  "kind": "collectionType",
  "collectionName": "leadership_people",
  "info": {
    "singularName": "leadership-person",
    "pluralName": "leadership-people",
    "displayName": "Leadership Person",
    "description": "Leadership team members for the About page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true },
    "role": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "summary": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "group": {
      "type": "enumeration",
      "enum": ["board", "executive", "advisor"],
      "default": "executive"
    },
    "order": { "type": "integer", "default": 0 },
    "portrait": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
