{
  "kind": "collectionType",
  "collectionName": "media_galleries",
  "info": {
    "singularName": "media-gallery",
    "pluralName": "media-galleries",
    "displayName": "Media Gallery",
    "description": "A gallery of images/videos, optionally tied to an event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "race-day",
        "stable-life",
        "venue",
        "jockey",
        "hospitality",
        "press",
        "other"
      ]
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "mediaItems": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "relatedEvent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "shared",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    }
  }
}
