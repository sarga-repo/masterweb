{
  "kind": "collectionType",
  "collectionName": "motorsport_leadership_people",
  "info": { "singularName": "motorsport-leadership-person", "pluralName": "motorsport-leadership-people", "displayName": "Motorsport Leadership Person", "description": "Motorsport leadership team members for the About page" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "config": {
    "metadatas": {
      "portrait": {
        "edit": {
          "description": "Leadership portrait: 1000 × 1250 px (4:5) recommended. Keep the face and shoulders inside the center safe area."
        }
      },
      "name": { "edit": { "description": "Person name shown in the Motorsport About leadership section." } },
      "role": { "edit": { "description": "Leadership role shown below the person name." } },
      "summary": { "edit": { "description": "Short leadership profile summary shown in the About page team area." } },
      "group": { "edit": { "description": "Leadership grouping used to organize the About page team list." } },
      "site": { "edit": { "description": "Optional site relation for multisite ownership." } },
      "order": { "edit": { "description": "Display order in the About page team list; lower numbers appear first." } }
    }
  },
  "attributes": {
    "name": { "type": "string", "required": true },
    "role": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "summary": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "group": { "type": "enumeration", "enum": ["board", "executive", "advisor"], "default": "executive" },
    "site": { "type": "relation", "relation": "manyToOne", "target": "api::site.site" },
    "order": { "type": "integer", "default": 0 },
    "portrait": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "legacySourceDocumentId": { "type": "string", "private": true, "configurable": false }
  }
}
