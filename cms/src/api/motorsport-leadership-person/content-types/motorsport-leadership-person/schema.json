{
  "kind": "collectionType",
  "collectionName": "motorsport_leadership_people",
  "info": { "singularName": "motorsport-leadership-person", "pluralName": "motorsport-leadership-people", "displayName": "Motorsport Leadership Person", "description": "Motorsport leadership team members for the About page" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true },
    "role": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "summary": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "group": { "type": "enumeration", "enum": ["board", "executive", "advisor"], "default": "executive" },
    "site": { "type": "relation", "relation": "manyToOne", "target": "api::site.site" },
    "order": { "type": "integer", "default": 0 },
    "portrait": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "legacySourceDocumentId": { "type": "string", "private": true, "configurable": false }
  }
}
