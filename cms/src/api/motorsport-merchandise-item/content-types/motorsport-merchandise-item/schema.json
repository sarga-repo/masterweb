{
  "kind": "collectionType",
  "collectionName": "motorsport_merchandise_items",
  "info": { "singularName": "motorsport-merchandise-item", "pluralName": "motorsport-merchandise-items", "displayName": "Motorsport Merchandise Item", "description": "Motorsport merchandise showcase teasers without internal commerce" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "config": {
    "metadatas": {
      "image": {
        "edit": {
          "description": "Merchandise image: 1200 × 1200 px (1:1) recommended with the product centered and transparent or neutral background."
        }
      },
      "title": { "edit": { "description": "Product or merchandise item name shown in the showcase." } },
      "slug": { "edit": { "description": "Stable merchandise item identifier for future external detail linking." } },
      "description": { "edit": { "description": "Short product description shown in the merchandise showcase." } },
      "priceLabel": { "edit": { "description": "Optional display price or price-from label; no checkout is processed here." } },
      "availabilityStatus": { "edit": { "description": "Controls whether the item is coming soon, externally available, inquiry-only, or hidden." } },
      "externalUrl": { "edit": { "description": "Optional approved external product destination." } },
      "sortOrder": { "edit": { "description": "Merchandise display order; lower numbers appear first." } },
      "seo": { "edit": { "description": "Optional search and social metadata for the merchandise item." } }
    }
  },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "richtext", "pluginOptions": { "i18n": { "localized": true } } },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "priceLabel": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "availabilityStatus": { "type": "enumeration", "enum": ["comingSoon", "availableExternal", "inquiryOnly", "hidden"], "default": "comingSoon", "required": true },
    "externalUrl": { "type": "string" },
    "sortOrder": { "type": "integer", "default": 0 },
    "seo": { "type": "component", "component": "shared.seo", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } },
    "legacySourceDocumentId": { "type": "string", "private": true, "configurable": false }
  }
}
