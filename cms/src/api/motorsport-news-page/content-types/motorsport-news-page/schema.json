{
  "kind": "singleType",
  "info": {
    "singularName": "motorsport-news-page",
    "pluralName": "motorsport-news-pages",
    "displayName": "Motorsport News Page",
    "description": "CMS content for the public Sarga Motorsport News hub. Edit the hero, editorial controls, lead story, archive, and gallery CTA in page order."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "config": {
    "metadatas": {
      "routePath": { "edit": { "description": "Canonical frontend path for this page. Keep this as /news." } },
      "routeAliases": { "edit": { "description": "Optional legacy paths that should resolve to this page during migration." } },
      "title": { "edit": { "description": "Internal page name used in metadata and CMS identification." } },
      "navigationLabel": { "edit": { "description": "Optional navigation label retained for page metadata; the header uses the Top Navigation collection." } },
      "hero": { "edit": { "description": "News hub hero copy, media, visibility controls, and optional archive metrics." } },
      "informationBand": { "edit": { "description": "Blue editorial-control band displayed below the News hero." } },
      "leadStorySection": { "edit": { "description": "Lead-story presentation and CTA. The lead article itself comes from Motorsport News records." } },
      "archiveIntroSection": { "edit": { "description": "Archive heading and ordering copy above the article list." } },
      "galleryCtaSection": { "edit": { "description": "Visual archive CTA near the bottom of the News page." } },
      "pageAvailability": { "edit": { "description": "Controls whether the public News page is available or shows Coming Soon." } },
      "seo": { "edit": { "description": "Search and social metadata used by the News page." } }
    }
  },
  "attributes": {
    "siteScope": { "type": "enumeration", "enum": ["motorsport"], "default": "motorsport", "required": true, "private": true },
    "routePath": { "type": "string", "default": "/news", "required": true, "pluginOptions": { "i18n": { "localized": false } } },
    "routeAliases": { "type": "json", "default": [], "pluginOptions": { "i18n": { "localized": false } } },
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "navigationLabel": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "hero": { "type": "component", "component": "motorsport.page-hero", "repeatable": false, "required": false, "pluginOptions": { "i18n": { "localized": true } } },
    "informationBand": { "type": "component", "component": "motorsport.page-information-band", "repeatable": false, "required": false, "pluginOptions": { "i18n": { "localized": true } } },
    "leadStorySection": { "type": "component", "component": "motorsport.page-section", "repeatable": false, "required": false, "pluginOptions": { "i18n": { "localized": true } } },
    "archiveIntroSection": { "type": "component", "component": "motorsport.page-section", "repeatable": false, "required": false, "pluginOptions": { "i18n": { "localized": true } } },
    "galleryCtaSection": { "type": "component", "component": "motorsport.page-section", "repeatable": false, "required": false, "pluginOptions": { "i18n": { "localized": true } } },
    "pageAvailability": { "type": "component", "component": "shared.page-availability", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } },
    "seo": { "type": "component", "component": "shared.seo", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } }
  }
}
