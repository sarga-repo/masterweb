{
  "kind": "collectionType",
  "collectionName": "motorsport_partners",
  "info": { "singularName": "motorsport-partner", "pluralName": "motorsport-partners", "displayName": "Motorsport Partner", "description": "Motorsport sponsors and partners displayed across Motorsport routes" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "config": {
    "metadatas": {
      "logo": {
        "edit": {
          "description": "Partner logo: SVG preferred; otherwise transparent PNG at 800 × 400 px (2:1) with generous clear space."
        }
      },
      "name": { "edit": { "description": "Partner name shown beside the logo and in accessible text." } },
      "slug": { "edit": { "description": "Stable partner identifier for internal linking and content management." } },
      "websiteUrl": { "edit": { "description": "Optional HTTPS destination opened when the partner logo is selected." } },
      "partnerType": { "edit": { "description": "Partner classification used for editorial organization." } },
      "sortOrder": { "edit": { "description": "Logo order in partner strips; lower numbers appear first." } },
      "isActive": { "edit": { "description": "Show this partner in public Motorsport partner queries." } }
    }
  },
  "attributes": {
    "name": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "websiteUrl": { "type": "string" },
    "partnerType": { "type": "enumeration", "enum": ["sponsor", "technical", "media", "broadcast", "government", "community", "other"], "default": "sponsor" },
    "sortOrder": { "type": "integer", "default": 0 },
    "isActive": { "type": "boolean", "default": true },
    "legacySourceDocumentId": { "type": "string", "private": true, "configurable": false }
  }
}
