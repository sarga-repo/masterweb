{
  "kind": "collectionType",
  "collectionName": "motorsport_programs",
  "info": {
    "singularName": "motorsport-program",
    "pluralName": "motorsport-programs",
    "displayName": "Motorsport Program",
    "description": "Motorsport program and campaign hubs such as IJTC and FIA Rallycross. The FIA Rallycross event detail URL is managed by the program with slug fia-rallycross-world-cup-indonesia-2026."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "config": {
    "metadatas": {
      "motorsportPresentation": {
        "edit": {
          "description": "01 — Hero and information band. This is the first presentation group rendered on the programme page. Edit Hero first, then Information Band."
        }
      },
      "heroMedia": {
        "edit": {
          "description": "02 — Legacy programme fallback image. Recommended 2400 × 1200 px (2:1). For the campaign hero, edit Motorsport Presentation > Hero instead. This field remains as a safe fallback for older records."
        }
      },
      "bannerSlides": {
        "edit": {
          "description": "03 — Campaign carousel slides, shown after the hero and information band. Set image, title, description, CTA, and sort order per slide."
        }
      },
      "presentationSections": {
        "edit": {
          "description": "04 — Supporting named sections for the FIA campaign. Add or expand sections with sectionKey format, rundown, or race-day-guide. Edit each section's isActive/show* controls and copy; Format cards are managed in the nested items list."
        }
      },
      "eventMenuLabel": {
        "edit": {
          "description": "Short localized label used in the Motorsport Event navigation dropdown."
        }
      },
      "rundown": {
        "edit": {
          "description": "05 — Race-day schedule items rendered in the programme rundown. Each item has isActive and sortOrder, followed by its day, time, title, and description."
        }
      },
      "eventRules": {
        "edit": {
          "description": "06 — Sporting rules and Do/Do not guidance for the programme. Each item has isActive and sortOrder, followed by its type, title, and description."
        }
      }
    }
  },
  "attributes": {
    "motorsportPresentation": {
      "type": "component",
      "component": "motorsport.detail-presentation",
      "repeatable": false,
      "required": false,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "bannerSlides": {
      "type": "component",
      "component": "motorsport.campaign-slide",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "presentationSections": {
      "type": "component",
      "component": "motorsport.page-section",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "eventMenuLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "eventMenuEnabled": { "type": "boolean", "default": true },
    "programType": {
      "type": "enumeration",
      "enum": ["juniorTalentCup", "rallycross", "raceWeekend", "other"],
      "required": true
    },
    "programStatus": {
      "type": "enumeration",
      "enum": [
        "announced",
        "registrationOpen",
        "ticketsOpen",
        "live",
        "completed",
        "hidden"
      ],
      "default": "announced",
      "required": true
    },
    "seasonLabel": { "type": "string", "required": true },
    "summary": {
      "type": "richtext",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "mainHeadline": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "eventStartDate": { "type": "datetime" },
    "eventEndDate": { "type": "datetime" },
    "venue": { "type": "string" },
    "rundown": {
      "type": "component",
      "component": "motorsport.rundown-item",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "eventRules": {
      "type": "component",
      "component": "motorsport.rule-item",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "primaryCtaLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "primaryCtaUrl": { "type": "string" },
    "becomeRidersLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "becomeRidersUrl": { "type": "string" },
    "relatedEvents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::motorsport-event.motorsport-event"
    },
    "relatedTicketCtas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-ticket-cta.motorsport-ticket-cta",
      "mappedBy": "relatedProgram"
    },
    "riders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-rider.motorsport-rider",
      "mappedBy": "program"
    },
    "standings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-standing.motorsport-standing",
      "mappedBy": "program"
    },
    "regulations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-regulation.motorsport-regulation",
      "mappedBy": "program"
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "motorsport",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
