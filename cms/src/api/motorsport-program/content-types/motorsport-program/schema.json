{
  "kind": "collectionType",
  "collectionName": "motorsport_programs",
  "info": {
    "singularName": "motorsport-program",
    "pluralName": "motorsport-programs",
    "displayName": "Motorsport Program",
    "description": "Motorsport program and campaign hubs such as IJTC and FIA Rallycross"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "programType": {
      "type": "enumeration",
      "enum": ["juniorTalentCup", "rallycross", "raceWeekend", "other"],
      "required": true
    },
    "programStatus": {
      "type": "enumeration",
      "enum": ["announced", "registrationOpen", "ticketsOpen", "live", "completed", "hidden"],
      "default": "announced",
      "required": true
    },
    "seasonLabel": { "type": "string", "required": true },
    "summary": { "type": "richtext", "required": true },
    "mainHeadline": { "type": "string" },
    "eventStartDate": { "type": "datetime" },
    "eventEndDate": { "type": "datetime" },
    "venue": { "type": "string" },
    "heroMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "bannerSlides": {
      "type": "component",
      "component": "motorsport.campaign-slide",
      "repeatable": true
    },
    "rundown": {
      "type": "component",
      "component": "motorsport.rundown-item",
      "repeatable": true
    },
    "eventRules": {
      "type": "component",
      "component": "motorsport.rule-item",
      "repeatable": true
    },
    "primaryCtaLabel": { "type": "string" },
    "primaryCtaUrl": { "type": "string" },
    "becomeRidersLabel": { "type": "string" },
    "becomeRidersUrl": { "type": "string" },
    "relatedEvents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event"
    },
    "relatedTicketCtas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ticket-cta.ticket-cta"
    },
    "riders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-rider.motorsport-rider",
      "mappedBy": "program"
    },
    "standings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-standing.motorsport-standing",
      "mappedBy": "program"
    },
    "regulations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-regulation.motorsport-regulation",
      "mappedBy": "program"
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "motorsport",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
