{
  "kind": "collectionType",
  "collectionName": "motorsport_programs",
  "info": {
    "singularName": "motorsport-program",
    "pluralName": "motorsport-programs",
    "displayName": "Motorsport Program",
    "description": "Motorsport program and campaign hubs such as IJTC and FIA Rallycross"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "motorsportPresentation": {
      "type": "component",
      "component": "motorsport.detail-presentation",
      "repeatable": false,
      "required": false,
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "01 — Hero and information band. This is the first presentation group rendered on the programme page. Edit Hero first, then Information Band."
    },
    "heroMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"],
      "description": "02 — Legacy programme fallback image. For the campaign hero, edit Motorsport Presentation > Hero instead. This field remains as a safe fallback for older records."
    },
    "bannerSlides": {
      "type": "component",
      "component": "motorsport.campaign-slide",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "03 — Campaign carousel slides, shown after the hero and information band. Set image, title, description, CTA, and sort order per slide."
    },
    "presentationSections": {
      "type": "component",
      "component": "motorsport.page-section",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "04 — Supporting named sections such as Format and Rundown. These are not carousel slides; each item controls its own copy, media, visibility, and order."
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "eventMenuLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "Short localized label used in the Motorsport Event navigation dropdown."
    },
    "eventMenuEnabled": { "type": "boolean", "default": true },
    "programType": {
      "type": "enumeration",
      "enum": ["juniorTalentCup", "rallycross", "raceWeekend", "other"],
      "required": true
    },
    "programStatus": {
      "type": "enumeration",
      "enum": [
        "announced",
        "registrationOpen",
        "ticketsOpen",
        "live",
        "completed",
        "hidden"
      ],
      "default": "announced",
      "required": true
    },
    "seasonLabel": { "type": "string", "required": true },
    "summary": {
      "type": "richtext",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "mainHeadline": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "eventStartDate": { "type": "datetime" },
    "eventEndDate": { "type": "datetime" },
    "venue": { "type": "string" },
    "rundown": {
      "type": "component",
      "component": "motorsport.rundown-item",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "05 — Race-day schedule items rendered in the programme rundown."
    },
    "eventRules": {
      "type": "component",
      "component": "motorsport.rule-item",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "06 — Sporting rules and do/don't guidance for the programme."
    },
    "primaryCtaLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "primaryCtaUrl": { "type": "string" },
    "becomeRidersLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "becomeRidersUrl": { "type": "string" },
    "relatedEvents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::motorsport-event.motorsport-event"
    },
    "relatedTicketCtas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ticket-cta.ticket-cta"
    },
    "riders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-rider.motorsport-rider",
      "mappedBy": "program"
    },
    "standings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-standing.motorsport-standing",
      "mappedBy": "program"
    },
    "regulations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::motorsport-regulation.motorsport-regulation",
      "mappedBy": "program"
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "motorsport",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
