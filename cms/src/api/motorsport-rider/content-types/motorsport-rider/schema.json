{
  "kind": "collectionType",
  "collectionName": "motorsport_riders",
  "info": {
    "singularName": "motorsport-rider",
    "pluralName": "motorsport-riders",
    "displayName": "Motorsport Rider",
    "description": "Program-linked rider profiles"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "config": {
    "metadatas": {
      "portrait": {
        "edit": {
          "description": "Rider portrait: 1000 × 1250 px (4:5) recommended. Keep helmet/face and shoulders within the center safe area."
        }
      },
      "motorsportPresentation": { "edit": { "description": "Optional shared detail presentation retained for future rider-profile variants; the current rider route uses rider fields directly." } },
      "name": { "edit": { "description": "Rider name shown in the catalogue, profile hero, and metadata." } },
      "slug": { "edit": { "description": "Stable rider profile URL identifier. Change only with a redirect plan." } },
      "bio": { "edit": { "description": "Approved rider biography shown on the rider profile page." } },
      "program": { "edit": { "description": "Programme that owns this rider record. IJTC rider pages only show records related to the selected programme." } },
      "number": { "edit": { "description": "Competition number shown beside the rider name and portrait." } },
      "team": { "edit": { "description": "Rider team or academy shown in profile metadata and standings." } },
      "region": { "edit": { "description": "Rider region shown in the profile and catalogue." } },
      "nationality": { "edit": { "description": "Rider nationality shown in the profile metadata." } },
      "isActive": { "edit": { "description": "Show this rider in the public catalogue and related programme queries." } },
      "sortOrder": { "edit": { "description": "Catalogue order within the selected programme; lower numbers appear first." } },
      "siteScope": { "edit": { "description": "Site visibility scope. Use motorsport for the dedicated Motorsport frontend." } },
      "sites": { "edit": { "description": "Optional multisite assignments for this rider record." } },
      "seo": { "edit": { "description": "Optional search and social metadata for the rider profile." } }
    }
  },
  "attributes": {
    "motorsportPresentation": {
      "type": "component",
      "component": "motorsport.detail-presentation",
      "repeatable": false,
      "required": false,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "portrait": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "bio": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "program": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::motorsport-program.motorsport-program",
      "inversedBy": "riders",
      "required": true
    },
    "number": { "type": "string" },
    "team": { "type": "string" },
    "region": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "nationality": { "type": "string" },
    "isActive": { "type": "boolean", "default": true },
    "sortOrder": { "type": "integer", "default": 0 },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "motorsport",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
