{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": {
    "singularName": "news-article",
    "pluralName": "news-articles",
    "displayName": "News Article",
    "description": "News, publications, reports, and magazine stories"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": { "type": "text", "required": true },
    "body": { "type": "richtext" },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "news",
        "publication",
        "press-release",
        "report",
        "magazine",
        "race-report",
        "announcement",
        "lifestyle",
        "community",
        "media"
      ],
      "default": "news",
      "required": true
    },
    "publishedDate": { "type": "date", "required": true },
    "isHotTopic": { "type": "boolean", "default": false },
    "author": { "type": "string" },
    "relatedBusinesses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ecosystem-business.ecosystem-business",
      "inversedBy": "relatedArticles"
    },
    "relatedEvent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "shared", "hidden"],
      "default": "gateway",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "showOnGateway": { "type": "boolean", "default": true },
    "showOnMotorsport": { "type": "boolean", "default": false },
    "featuredOnGateway": { "type": "boolean", "default": false },
    "featuredOnMotorsport": { "type": "boolean", "default": false },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
