{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": {
    "singularName": "news-article",
    "pluralName": "news-articles",
    "displayName": "News Article",
    "description": "News, publications, reports, and magazine stories"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "body": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "news",
        "publication",
        "press-release",
        "report",
        "magazine",
        "race-report",
        "announcement",
        "lifestyle",
        "community",
        "media",
        "race-results",
        "event-announcement",
        "turf-venue",
        "stable-life",
        "jockey-story",
        "equine-performance",
        "partnership"
      ],
      "default": "news",
      "required": true
    },
    "publishedDate": { "type": "date", "required": true },
    "isHotTopic": { "type": "boolean", "default": false },
    "author": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "relatedBusinesses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ecosystem-business.ecosystem-business",
      "inversedBy": "relatedArticles"
    },
    "relatedEvent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "gateway",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "showOnGateway": { "type": "boolean", "default": true },
    "showOnMotorsport": { "type": "boolean", "default": false },
    "showOnHorseSport": { "type": "boolean", "default": false },
    "featuredOnGateway": { "type": "boolean", "default": false },
    "featuredOnMotorsport": { "type": "boolean", "default": false },
    "featuredOnHorseSport": { "type": "boolean", "default": false },
    "relatedGallery": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::media-gallery.media-gallery"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
