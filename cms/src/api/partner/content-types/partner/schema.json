{
  "kind": "collectionType",
  "collectionName": "partners",
  "info": {
    "singularName": "partner",
    "pluralName": "partners",
    "displayName": "Partner",
    "description": "Sponsors and partners displayed across Sarga sites"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "websiteUrl": { "type": "string" },
    "partnerType": {
      "type": "enumeration",
      "enum": ["sponsor", "technical", "media", "broadcast", "government", "community", "other"],
      "default": "sponsor"
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "shared", "hidden"],
      "default": "shared",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "sortOrder": { "type": "integer", "default": 0 },
    "isActive": { "type": "boolean", "default": true }
  }
}
