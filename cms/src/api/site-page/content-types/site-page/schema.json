{
  "kind": "collectionType",
  "collectionName": "site_pages",
  "info": {
    "singularName": "site-page",
    "pluralName": "site-pages",
    "displayName": "Site Page",
    "description": "Site-scoped page content. Use pageKind to select the page family; optional homepage fields are not required on About, News, Campaign, or Custom pages."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": { "type": "string", "required": true },
    "routePath": { "type": "string", "required": true },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "gateway",
      "required": true
    },
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site"
    },
    "pageKind": {
      "type": "enumeration",
      "enum": [
        "home",
        "about",
        "eventHub",
        "newsHub",
        "campaign",
        "merchandise",
        "history",
        "reportIndex",
        "legal",
        "custom"
      ],
      "default": "custom",
      "required": true
    },
    "navigationLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroTitle": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroDescription": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroEnabled": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Controls whether the page hero is rendered on the public Motorsport route."
    },
    "heroMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "heroVideo": {
      "description": "Optional cinematic hero video. Use for pages with an approved video hero; leave empty for standard image-led pages.",
      "type": "component",
      "component": "shared.hero-video",
      "repeatable": false,
      "required": false
    },
    "heroSlides": {
      "description": "Motorsport homepage carousel slides only. Leave empty on About, News, Events, Campaign, Tickets, Gallery, Partners, and Merchandise pages.",
      "type": "component",
      "repeatable": true,
      "component": "motorsport.hero-slide",
      "max": 3,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "motorsportFeaturedEvent": {
      "description": "Motorsport homepage featured event relation only.",
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    },
    "motorsportInformationBand": {
      "description": "Motorsport homepage Race Control information band only.",
      "type": "component",
      "component": "motorsport.home-information-band",
      "repeatable": false,
      "required": false,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "motorsportWorldSection": {
      "description": "Motorsport homepage World of Motorsport section only.",
      "type": "component",
      "component": "motorsport.world-of-motorsport",
      "repeatable": false,
      "required": false,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "motorsportTicketSection": {
      "description": "Motorsport homepage ticket card only. Controls its complete copy, artwork, visibility, footer metadata, and approved partner CTA.",
      "type": "component",
      "component": "motorsport.home-ticket-section",
      "repeatable": false,
      "required": false,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "pageAvailability": {
      "description": "Optional availability/Coming Soon state. Leave empty while page is active and published.",
      "type": "component",
      "component": "shared.page-availability",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "sections": {
      "description": "Page-specific editorial sections rendered by route. Use this for About, News, Events, Tickets, Gallery, Partners, Contact, and Motorsport About Capabilities.",
      "type": "dynamiczone",
      "components": [
        "shared.page-section",
        "motorsport.about-capabilities"
      ],
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "description": "Search and social metadata. Use metaTitle/metaDescription first; add OG image and canonical only when approved.",
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
