{
  "kind": "collectionType",
  "collectionName": "ticket_ctas",
  "info": {
    "singularName": "ticket-cta",
    "pluralName": "ticket-ctas",
    "displayName": "Ticket CTA",
    "description": "Centralized partner ticket call-to-action (redirect / deep link / configurable embed). No internal payment."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "label": { "type": "string", "required": true },
    "provider": { "type": "string" },
    "eyebrow": { "type": "string" },
    "description": { "type": "text" },
    "eventLabel": { "type": "string" },
    "eventText": { "type": "string" },
    "providerLabel": { "type": "string" },
    "providerText": { "type": "string" },
    "partnerLabel": { "type": "string" },
    "footerText": { "type": "string" },
    "ctaLabel": { "type": "string" },
    "ctaType": {
      "type": "enumeration",
      "enum": ["redirect", "deepLink", "embed"],
      "default": "redirect",
      "required": true
    },
    "url": { "type": "string" },
    "embedCode": { "type": "text", "private": true },
    "embedConfigJson": { "type": "json" },
    "trackingParams": { "type": "json" },
    "activeFrom": { "type": "datetime" },
    "activeUntil": { "type": "datetime" },
    "isActive": { "type": "boolean", "default": true },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Optional artwork or photography shown in homepage ticket panels."
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Optional artwork or photography shown behind the main ticket copy."
    },
    "backgroundImageMobile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Optional mobile-specific ticket artwork. Falls back to backgroundImage when empty."
    },
    "siteScope": {
      "type": "enumeration",
      "enum": ["gateway", "motorsport", "horsesport", "shared", "hidden"],
      "default": "shared",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "relatedEvent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "ticketCtas"
    }
  }
}
