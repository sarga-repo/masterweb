{
  "collectionName": "components_motorsport_about_capability_cards",
  "info": {
    "displayName": "About Capability Card",
    "description": "Ordered, site-owned capability card for the Motorsport About page"
  },
  "options": {},
  "config": {
    "metadatas": {
      "indexLabel": {
        "edit": {
          "description": "Optional label shown above the card title. Defaults to 01, 02, 03… if empty."
        }
      }
      ,
      "internalName": { "edit": { "description": "Internal editor key for this capability card; it is not shown publicly." } },
      "enabled": { "edit": { "description": "Show this capability card." } },
      "title": { "edit": { "description": "Capability card heading shown in the About grid." } },
      "description": { "edit": { "description": "Short capability explanation shown below the card heading." } },
      "sortOrder": { "edit": { "description": "Lower numbers appear first in the capability grid." } },
      "accent": { "edit": { "description": "Approved Motorsport accent treatment for this capability card." } }
    }
  },
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "indexLabel": {
      "type": "string",
      "maxLength": 20,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "required": true,
      "maxLength": 320,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    },
    "accent": {
      "type": "enumeration",
      "enum": ["crimson", "orange", "yellow", "teal", "blue"],
      "default": "crimson",
      "required": true
    }
  }
}
