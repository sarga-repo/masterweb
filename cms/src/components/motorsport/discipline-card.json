{
  "collectionName": "components_motorsport_discipline_cards",
  "info": {
    "displayName": "Motorsport Discipline Card",
    "description": "Ordered homepage racing-format card with managed media and destination"
  },
  "options": {},
  "config": {
    "metadatas": {
      "image": {
        "edit": {
          "description": "Discipline card image: 1600 × 1000 px (8:5) recommended. Keep the action and vehicle/rider inside the crop-safe center area."
        }
      },
      "internalName": { "edit": { "description": "Internal editor label for this homepage discipline card." } },
      "enabled": { "edit": { "description": "Show this discipline card on the Motorsport homepage." } },
      "title": { "edit": { "description": "Public discipline name shown on the homepage card." } },
      "shortLabel": { "edit": { "description": "Short label shown in compact discipline contexts." } },
      "imageAlt": { "edit": { "description": "Accessible description of the discipline card image." } },
      "href": { "edit": { "description": "Internal destination opened from the discipline card." } },
      "accent": { "edit": { "description": "Approved visual accent color for the discipline card." } },
      "sortOrder": { "edit": { "description": "Homepage card order; lower numbers appear first." } }
      }
  },
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "shortLabel": {
      "type": "string",
      "maxLength": 60
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageAlt": {
      "type": "string",
      "maxLength": 180
    },
    "href": {
      "type": "string",
      "required": true,
      "default": "/events"
    },
    "accent": {
      "type": "enumeration",
      "enum": ["crimson", "orange", "yellow", "teal", "blue"],
      "default": "crimson",
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    }
  }
}
