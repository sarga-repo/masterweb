{
  "collectionName": "components_motorsport_hero_slides",
  "info": {
    "displayName": "Hero Slide",
    "description": "Site-scoped Motorsport homepage carousel slide"
  },
  "options": {},
  "config": {
    "metadatas": {
      "image": {
        "edit": {
          "description": "Desktop hero artwork: 2400 × 1200 px (2:1) recommended. Keep the main subject near the selected focal anchor."
        }
      },
      "mobileImage": {
        "edit": {
          "description": "Optional mobile hero artwork: 1080 × 1350 px (4:5) recommended. Use this when the desktop crop does not preserve the subject."
        }
      },
      "ctaLabel": {
        "edit": {
          "description": "Short action label, for example Explore events or Read the story."
        }
      },
      "ctaUrl": {
        "edit": {
          "description": "Use an internal path beginning with / or an approved HTTPS external URL. External URLs open in a new tab."
        }
      },
      "internalName": { "edit": { "description": "Internal editor label for this homepage Hero slide." } },
      "eyebrow": { "edit": { "description": "Short context line shown above the Hero title." } },
      "title": { "edit": { "description": "Main homepage Hero headline." } },
      "description": { "edit": { "description": "Supporting homepage Hero copy." } },
      "video": { "edit": { "description": "Optional approved Hero video with a poster image." } },
      "imageAlt": { "edit": { "description": "Accessible description of the Hero artwork." } },
      "subjectAnchor": { "edit": { "description": "Focal position used when cropping the Hero artwork." } },
      "isActive": { "edit": { "description": "Include this slide in the homepage carousel." } },
      "sortOrder": { "edit": { "description": "Homepage carousel order; lower numbers appear first." } }
      }
  },
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "description": {
      "type": "text",
      "maxLength": 160
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "video": {
      "type": "component",
      "component": "shared.hero-video",
      "repeatable": false,
      "required": false
    },
    "imageAlt": {
      "type": "string",
      "required": true,
      "maxLength": 180
    },
    "subjectAnchor": {
      "type": "enumeration",
      "enum": ["left", "center", "right"],
      "default": "center",
      "required": true
    },
    "ctaLabel": {
      "type": "string",
      "maxLength": 28
    },
    "ctaUrl": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    }
  }
}
