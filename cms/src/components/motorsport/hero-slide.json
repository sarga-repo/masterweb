{
  "collectionName": "components_motorsport_hero_slides",
  "info": {
    "displayName": "Hero Slide",
    "description": "Site-scoped Motorsport homepage carousel slide"
  },
  "options": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "description": {
      "type": "text",
      "maxLength": 160
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"],
      "description": "Desktop hero artwork: 2400 × 1200 px (2:1) recommended. Keep the main subject near the selected focal anchor."
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Optional mobile hero artwork: 1080 × 1350 px (4:5) recommended. Use this when the desktop crop does not preserve the subject."
    },
    "video": {
      "type": "component",
      "component": "shared.hero-video",
      "repeatable": false,
      "required": false
    },
    "imageAlt": {
      "type": "string",
      "required": true,
      "maxLength": 180
    },
    "subjectAnchor": {
      "type": "enumeration",
      "enum": ["left", "center", "right"],
      "default": "center",
      "required": true
    },
    "ctaLabel": {
      "type": "string",
      "maxLength": 28,
      "description": "Short action label, for example Explore events or Read the story."
    },
    "ctaUrl": {
      "type": "string",
      "description": "Use an internal path beginning with / or an approved HTTPS external URL. External URLs open in a new tab."
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    }
  }
}
