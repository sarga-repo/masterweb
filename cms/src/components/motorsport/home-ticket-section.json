{
  "collectionName": "components_motorsport_home_ticket_sections",
  "info": {
    "displayName": "Homepage Ticket Card",
    "description": "Complete CMS-managed Motorsport homepage ticket card. The link must redirect to an approved partner; Sarga does not process payment."
  },
  "options": {},
  "config": {
    "metadatas": {
      "backgroundImage": {
        "edit": {
          "description": "Optional ticket background: 1920 × 900 px (approximately 2.13:1) recommended. Keep copy-safe negative space around the focal subject."
        }
      },
      "backgroundImageMobile": {
        "edit": {
          "description": "Optional mobile ticket background: 1080 × 1350 px (4:5) recommended. Falls back to backgroundImage when empty."
        }
      },
      "ctaUrl": {
        "edit": {
          "description": "Approved internal or HTTPS partner destination. No checkout/payment URL is processed by Sarga."
        }
      },
      "isActive": { "edit": { "description": "Show the homepage ticket card." } },
      "eyebrow": { "edit": { "description": "Short context line above the ticket card title." } },
      "title": { "edit": { "description": "Homepage ticket card heading." } },
      "description": { "edit": { "description": "Ticket guidance shown before the external partner action." } },
      "eventLabel": { "edit": { "description": "Label for the automatically populated event metadata." } },
      "eventText": { "edit": { "description": "Event metadata shown in the homepage ticket card." } },
      "providerLabel": { "edit": { "description": "Label for the ticket provider metadata." } },
      "providerText": { "edit": { "description": "Provider text shown in the homepage ticket card." } },
      "partnerLabel": { "edit": { "description": "Partner disclosure shown near the ticket action." } },
      "footerText": { "edit": { "description": "Optional reassurance shown below the ticket action." } },
      "ctaLabel": { "edit": { "description": "Homepage ticket action label." } }
      }
  },
  "attributes": {
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 180,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "maxLength": 360,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "backgroundImageMobile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "eventLabel": {
      "type": "string",
      "default": "Event",
      "maxLength": 40,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "eventText": {
      "type": "string",
      "maxLength": 120,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "providerLabel": {
      "type": "string",
      "default": "Provider",
      "maxLength": 40,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "providerText": {
      "type": "string",
      "maxLength": 120,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "partnerLabel": {
      "type": "string",
      "default": "Partner redirect / Secure",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "footerText": {
      "type": "string",
      "maxLength": 180,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ctaLabel": {
      "type": "string",
      "default": "Secure your seat",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ctaUrl": {
      "type": "string"
    }
  }
}
