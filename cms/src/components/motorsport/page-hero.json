{
  "collectionName": "components_motorsport_page_heroes",
  "info": {
    "displayName": "Page Hero",
    "description": "Reusable Motorsport page hero contract. Layout and overlays remain frontend-owned; optional primary and secondary actions are managed here."
  },
  "options": {},
  "config": {
    "metadatas": {
      "showEyebrow": {
        "edit": {
          "description": "Show the hero eyebrow copy."
        }
      },
      "showTitle": {
        "edit": {
          "description": "Show the hero title copy."
        }
      },
      "showDescription": {
        "edit": {
          "description": "Show the hero description copy."
        }
      },
      "showMedia": {
        "edit": {
          "description": "Show the hero background media."
        }
      },
      "backgroundMedia": {
        "edit": {
          "description": "Desktop page hero: 2400 × 1200 px (2:1) recommended. Video may be MP4/WebM with a poster image."
        }
      },
      "mobileBackgroundMedia": {
        "edit": {
          "description": "Optional mobile page hero: 1080 × 1350 px (4:5) recommended. Falls back to the desktop artwork when empty."
        }
      },
      "showMetricGroup": {
        "edit": {
          "description": "Controls visibility of the hero metric group. When false, the complete group and its separators are hidden."
        }
      },
      "showPrimaryCta": {
        "edit": {
          "description": "Show the primary hero action. Set its label, URL, and target below."
        }
      },
      "showSecondaryCta": {
        "edit": {
          "description": "Show the secondary hero action. Set its label, URL, and target below."
        }
      },
      "primaryCtaLabel": {
        "edit": {
          "description": "Text shown on the primary hero action."
        }
      },
      "primaryCtaUrl": {
        "edit": {
          "description": "Primary hero destination. Use a local path such as /tickets or an approved HTTPS URL."
        }
      },
      "secondaryCtaLabel": {
        "edit": {
          "description": "Text shown on the secondary hero action."
        }
      },
      "secondaryCtaUrl": {
        "edit": {
          "description": "Secondary hero destination. Use a local path, a #section anchor, or an approved HTTPS URL."
        }
      },
      "isActive": { "edit": { "description": "Show this page Hero." } },
      "eyebrow": { "edit": { "description": "Short context line above the Hero title." } },
      "title": { "edit": { "description": "Main page Hero heading." } },
      "description": { "edit": { "description": "Supporting page Hero copy." } },
      "backgroundAlt": { "edit": { "description": "Accessible description for the Hero background media." } },
      "primaryCtaTarget": { "edit": { "description": "Choose whether the primary Hero action opens in the current window or a new window." } },
      "secondaryCtaTarget": { "edit": { "description": "Choose whether the secondary Hero action opens in the current window or a new window." } },
      "metrics": { "edit": { "description": "Optional ordered metric values shown in the Hero." } }
      }
  },
  "attributes": {
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "showEyebrow": { "type": "boolean", "default": true },
    "showTitle": { "type": "boolean", "default": true },
    "showDescription": { "type": "boolean", "default": true },
    "showMedia": { "type": "boolean", "default": true },
    "showPrimaryCta": { "type": "boolean", "default": true },
    "showSecondaryCta": { "type": "boolean", "default": true },
    "eyebrow": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 180,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "backgroundMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "mobileBackgroundMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "backgroundAlt": {
      "type": "string",
      "maxLength": 180,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "primaryCtaLabel": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "primaryCtaUrl": { "type": "string" },
    "primaryCtaTarget": {
      "type": "enumeration",
      "enum": ["sameWindow", "newWindow"],
      "default": "sameWindow"
    },
    "secondaryCtaLabel": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "secondaryCtaUrl": { "type": "string" },
    "secondaryCtaTarget": {
      "type": "enumeration",
      "enum": ["sameWindow", "newWindow"],
      "default": "sameWindow"
    },
    "showMetricGroup": {
      "type": "boolean",
      "default": true
    },
    "metrics": {
      "type": "component",
      "repeatable": true,
      "component": "motorsport.information-band-metric",
      "max": 3,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
