{
  "collectionName": "components_motorsport_page_information_bands",
  "info": {
    "displayName": "Page Information Band",
    "description": "Reusable Motorsport information band rendered immediately after a page hero."
  },
  "options": {},
  "config": {
    "metadatas": {
      "showEyebrow": {
        "edit": {
          "description": "Show the information band eyebrow copy."
        }
      },
      "showTitle": {
        "edit": {
          "description": "Show the information band title copy."
        }
      },
      "showDescription": {
        "edit": {
          "description": "Show the information band description copy."
        }
      },
      "showMetricGroup": {
        "edit": {
          "description": "Hides the complete right-bottom metric group and all of its separators when false."
        }
      }
    }
  },
  "attributes": {
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "showEyebrow": { "type": "boolean", "default": true },
    "showTitle": { "type": "boolean", "default": true },
    "showDescription": { "type": "boolean", "default": true },
    "eyebrow": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 180,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "showMetricGroup": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "metrics": {
      "type": "component",
      "repeatable": true,
      "component": "motorsport.information-band-metric",
      "max": 3,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
