{
  "collectionName": "components_motorsport_page_sections",
  "info": {
    "displayName": "Supporting Presentation Section",
    "description": "03 — A named supporting section such as Format, Rundown, or Race-day Guide. Use this for section copy, media, CTA, visibility, and order; do not use it for carousel slides."
  },
  "options": {},
  "config": {
    "metadatas": {
      "sectionKey": {
        "edit": {
          "description": "For the FIA campaign use format, rundown, or race-day-guide. This key connects the CMS section to its matching frontend section."
        }
      },
      "isActive": {
        "edit": {
          "description": "Show this named presentation section on the public page."
        }
      },
      "indexLabel": {
        "edit": {
          "description": "Short index or section identifier shown above the section title."
        }
      },
      "showIndex": {
        "edit": {
          "description": "Show the section index label."
        }
      },
      "showEyebrow": {
        "edit": {
          "description": "Show the section eyebrow copy."
        }
      },
      "showTitle": {
        "edit": {
          "description": "Show the section title copy."
        }
      },
      "showBody": {
        "edit": {
          "description": "Show the section body copy."
        }
      },
      "showMedia": {
        "edit": {
          "description": "Show the section media."
        }
      },
      "showCta": {
        "edit": {
          "description": "Show the section CTA."
        }
      },
      "supportLabel": {
        "edit": {
          "description": "Optional label shown beside supporting section copy or list metadata."
        }
      },
      "supportBody": {
        "edit": {
          "description": "Optional supporting rich text shown in the section header."
        }
      },
      "listLabel": {
        "edit": {
          "description": "Optional label shown above an automatically populated list inside this section, such as the Home event list."
        }
      },
      "itemCountLabel": {
        "edit": {
          "description": "Optional suffix shown after the automatically calculated item count, such as entries."
        }
      },
      "publicationTabLabel": {
        "edit": {
          "description": "Optional publications tab label for the Home Connected Records section."
        }
      },
      "leadershipTabLabel": {
        "edit": {
          "description": "Optional leadership tab label for the Home Connected Records section."
        }
      },
      "ecosystemTabLabel": {
        "edit": {
          "description": "Optional ecosystem tab label for the Home Connected Records section."
        }
      },
      "legalText": {
        "edit": {
          "description": "Optional legal or reassurance copy shown below the section actions."
        }
      },
      "media": {
        "edit": {
          "description": "Section media: 2000 × 1333 px (3:2) recommended for editorial images; use 2400 × 1200 px (2:1) for wide banners."
        }
      },
      "secondaryCtaLabel": {
        "edit": {
          "description": "Optional secondary action label for sections with two editorial destinations."
        }
      },
      "items": {
        "edit": {
          "description": "Optional ordered cards, bullets, or media items. Each item has its own show/hide control."
        }
      }
      ,
      "eyebrow": {
        "edit": {
          "description": "Short context line shown above the section title."
        }
      },
      "title": {
        "edit": {
          "description": "Main section heading shown on the public page."
        }
      },
      "body": {
        "edit": {
          "description": "Main rich text shown beneath the section heading."
        }
      },
      "ctaLabel": {
        "edit": {
          "description": "Text shown on the section's primary action link."
        }
      },
      "ctaUrl": {
        "edit": {
          "description": "Destination for the primary section action. Use a local path or approved HTTPS URL."
        }
      },
      "ctaTarget": {
        "edit": {
          "description": "Choose whether the primary section action opens in the current window or a new window."
        }
      },
      "theme": {
        "edit": {
          "description": "Select the approved visual surface treatment for this section."
        }
      },
      "secondaryCtaUrl": { "edit": { "description": "Optional secondary action destination. Use a local path or approved HTTPS URL." } },
      "secondaryCtaTarget": { "edit": { "description": "Choose whether the secondary action opens in the current window or a new window." } }
      }
  },
  "attributes": {
    "sectionKey": {
      "type": "string",
      "maxLength": 80
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "showIndex": { "type": "boolean", "default": true },
    "indexLabel": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "showEyebrow": { "type": "boolean", "default": true },
    "showTitle": { "type": "boolean", "default": true },
    "showBody": { "type": "boolean", "default": true },
    "showMedia": { "type": "boolean", "default": true },
    "showCta": { "type": "boolean", "default": true },
    "listLabel": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "itemCountLabel": {
      "type": "string",
      "maxLength": 40,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "publicationTabLabel": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "leadershipTabLabel": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ecosystemTabLabel": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "supportLabel": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "supportBody": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "legalText": {
      "type": "text",
      "maxLength": 300,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 180,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "body": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "ctaLabel": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ctaUrl": { "type": "string" },
    "ctaTarget": {
      "type": "enumeration",
      "enum": ["sameWindow", "newWindow"],
      "default": "sameWindow"
    },
    "secondaryCtaLabel": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "secondaryCtaUrl": { "type": "string" },
    "secondaryCtaTarget": {
      "type": "enumeration",
      "enum": ["sameWindow", "newWindow"],
      "default": "sameWindow"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "motorsport.page-section-item"
    },
    "theme": {
      "type": "enumeration",
      "enum": ["default", "dark", "light", "accent"],
      "default": "default"
    }
  }
}
