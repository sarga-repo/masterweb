{
  "collectionName": "components_motorsport_page_sections",
  "info": {
    "displayName": "Supporting Presentation Section",
    "description": "03 — A named supporting section such as Format or Rundown. Use this for section copy, media, CTA, visibility, and order; do not use it for carousel slides."
  },
  "options": {},
  "attributes": {
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "showIndex": { "type": "boolean", "default": true, "description": "Show the section index label." },
    "indexLabel": { "type": "string", "maxLength": 80, "pluginOptions": { "i18n": { "localized": true } } },
    "showEyebrow": { "type": "boolean", "default": true, "description": "Show the section eyebrow copy." },
    "showTitle": { "type": "boolean", "default": true, "description": "Show the section title copy." },
    "showBody": { "type": "boolean", "default": true, "description": "Show the section body copy." },
    "showMedia": { "type": "boolean", "default": true, "description": "Show the section media." },
    "showCta": { "type": "boolean", "default": true, "description": "Show the section CTA." },
    "supportLabel": { "type": "string", "maxLength": 100, "pluginOptions": { "i18n": { "localized": true } } },
    "supportBody": { "type": "richtext", "pluginOptions": { "i18n": { "localized": true } } },
    "legalText": {
      "type": "text",
      "maxLength": 300,
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "Optional legal or reassurance copy shown below the section actions."
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 180,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "body": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "ctaLabel": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ctaUrl": { "type": "string" },
    "ctaTarget": {
      "type": "enumeration",
      "enum": ["sameWindow", "newWindow"],
      "default": "sameWindow"
    },
    "secondaryCtaLabel": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "Optional secondary action label for sections with two editorial destinations."
    },
    "secondaryCtaUrl": { "type": "string" },
    "secondaryCtaTarget": {
      "type": "enumeration",
      "enum": ["sameWindow", "newWindow"],
      "default": "sameWindow"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "motorsport.page-section-item",
      "description": "Optional ordered cards, bullets, or media items. Each item has its own show/hide control."
    },
    "theme": {
      "type": "enumeration",
      "enum": ["default", "dark", "light", "accent"],
      "default": "default"
    }
  }
}
