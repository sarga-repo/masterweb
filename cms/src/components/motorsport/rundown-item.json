{
  "collectionName": "components_motorsport_rundown_items",
  "info": {
    "displayName": "Rundown Item",
    "description": "Public campaign or program schedule item. Each item can be shown or hidden independently and ordered with sortOrder."
  },
  "options": {},
  "config": {
    "metadatas": {
      "isActive": {
        "edit": {
          "description": "Show this schedule item on the public campaign page."
        }
      },
      "sortOrder": {
        "edit": {
          "description": "Lower numbers appear first in the rundown."
        }
      },
      "dayLabel": { "edit": { "description": "Day or session group label shown above the schedule item." } },
      "dateLabel": { "edit": { "description": "Public date text for this schedule item." } },
      "venue": { "edit": { "description": "Venue shown for this schedule item." } },
      "status": { "edit": { "description": "Schedule item state shown by the schedule card." } },
      "startTime": { "edit": { "description": "Optional public start time." } },
      "endTime": { "edit": { "description": "Optional public finish time." } },
      "title": { "edit": { "description": "Schedule item title shown on the public rundown." } },
      "description": { "edit": { "description": "Supporting schedule item description." } }
      }
  },
  "attributes": {
    "isActive": { "type": "boolean", "default": true },
    "dayLabel": { "type": "string", "required": true },
    "dateLabel": { "type": "string" },
    "venue": { "type": "string" },
    "status": {
      "type": "enumeration",
      "enum": ["upcoming", "live", "completed"],
      "default": "upcoming"
    },
    "startTime": { "type": "time" },
    "endTime": { "type": "time" },
    "title": { "type": "string", "required": true },
    "description": { "type": "text" },
    "sortOrder": { "type": "integer", "default": 0 }
  }
}
