{
  "collectionName": "components_shared_footer_links",
  "info": {
    "displayName": "Footer Link",
    "description": "A managed footer navigation or social link"
  },
  "options": {},
  "config": {
    "metadatas": {
      "icon": {
        "edit": {
          "description": "Optional social/partner icon: SVG preferred, or transparent PNG at 256 × 256 px."
        }
      }
    }
  },
  "attributes": {
    "label": { "type": "string", "required": true, "maxLength": 80 },
    "href": { "type": "string", "required": true, "maxLength": 500 },
    "linkType": {
      "type": "enumeration",
      "enum": ["internal", "external"],
      "default": "internal"
    },
    "openInNewTab": { "type": "boolean", "default": false },
    "enabled": { "type": "boolean", "default": true },
    "displayOrder": { "type": "integer", "default": 0, "min": 0, "max": 1000 },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
