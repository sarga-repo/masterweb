{
  "collectionName": "components_shared_page_sections",
  "info": {
    "displayName": "Page Section",
    "description": "Reusable editorial section for site-scoped pages"
  },
  "options": {},
  "attributes": {
    "sectionKey": { "type": "string", "required": true },
    "enabled": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Controls whether this section is rendered on the public page."
    },
    "eyebrow": { "type": "string" },
    "title": { "type": "string", "required": true },
    "body": { "type": "richtext" },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"],
      "description": "Shared section media: 2000 × 1333 px (3:2) recommended for images; use 2400 × 1200 px (2:1) for wide banners."
    },
    "ctaLabel": { "type": "string" },
    "ctaUrl": { "type": "string" },
    "ctaTarget": {
      "type": "enumeration",
      "enum": ["sameWindow", "newWindow"],
      "default": "sameWindow"
    },
    "theme": {
      "type": "enumeration",
      "enum": ["default", "dark", "light", "accent"],
      "default": "default"
    }
  }
}
