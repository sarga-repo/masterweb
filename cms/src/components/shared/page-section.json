{
  "collectionName": "components_shared_page_sections",
  "info": {
    "displayName": "Page Section",
    "description": "Reusable editorial section for site-scoped pages"
  },
  "options": {},
  "attributes": {
    "sectionKey": { "type": "string", "required": true },
    "eyebrow": { "type": "string" },
    "title": { "type": "string", "required": true },
    "body": { "type": "richtext" },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "ctaLabel": { "type": "string" },
    "ctaUrl": { "type": "string" },
    "ctaTarget": {
      "type": "enumeration",
      "enum": ["sameWindow", "newWindow"],
      "default": "sameWindow"
    },
    "theme": {
      "type": "enumeration",
      "enum": ["default", "dark", "light", "accent"],
      "default": "default"
    }
  }
}
