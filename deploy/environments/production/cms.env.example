# Sarga production shared Strapi CMS runtime environment.
# Copy to /etc/sarga/cms.env on the production VM, replace every
# REPLACE_WITH_* value through the approved secret channel, then chmod 640.
# Never commit the populated file.

NODE_ENV=production
HOST=127.0.0.1
PORT=1337
PUBLIC_URL=https://cms.sarga.co
PROXY_KOA=true

# Keep preview off until production preview UAT and ownership are approved.
PREVIEW_ENABLED=false
CLIENT_URL=https://motorsport.sarga.co
PREVIEW_URL=https://motorsport.sarga.co
PREVIEW_SECRET=REPLACE_WITH_PRODUCTION_PREVIEW_SECRET
PREVIEW_ALLOWED_ORIGINS=https://motorsport.sarga.co

# Server-to-server Motorsport cache invalidation.
MOTORSPORT_REVALIDATION_SECRET=REPLACE_WITH_PRODUCTION_MOTORSPORT_REVALIDATION_SECRET
MOTORSPORT_FRONTEND_REVALIDATE_URL=http://127.0.0.1:3001/api/revalidate

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sarga_strapi
DATABASE_USERNAME=sarga_cms
DATABASE_PASSWORD=REPLACE_WITH_PRODUCTION_DATABASE_PASSWORD
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

APP_KEYS=REPLACE_WITH_PRODUCTION_APP_KEY_1,REPLACE_WITH_PRODUCTION_APP_KEY_2,REPLACE_WITH_PRODUCTION_APP_KEY_3,REPLACE_WITH_PRODUCTION_APP_KEY_4
API_TOKEN_SALT=REPLACE_WITH_PRODUCTION_API_TOKEN_SALT
ADMIN_JWT_SECRET=REPLACE_WITH_PRODUCTION_ADMIN_JWT_SECRET
TRANSFER_TOKEN_SALT=REPLACE_WITH_PRODUCTION_TRANSFER_TOKEN_SALT
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET
ENCRYPTION_KEY=REPLACE_WITH_PRODUCTION_ENCRYPTION_KEY
CMS_PREVIEW_API_TOKEN_NAME=Read Only

# Production content comes from the approved staging promotion archive.
SEED_DEMO_CONTENT=false
MOTORSPORT_OWNERSHIP_MIGRATION_MODE=off
MOTORSPORT_LEGACY_RETIREMENT_MODE=off
MOTORSPORT_PAGE_SINGLE_TYPES_MIGRATE=false

# Keep mail disabled until the Exchange Online production launch gate is signed.
MAIL_ENABLED=false
MAIL_AUTH_MODE=oauth
MAIL_SMTP_HOST=smtp.office365.com
MAIL_SMTP_PORT=587
MAIL_SMTP_REQUIRE_TLS=true
MAIL_SMTP_USER=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sarga
MAIL_DEFAULT_REPLY_TO=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SMTP_SCOPE=https://outlook.office365.com/.default
MAIL_SMTP_PASSWORD=
MAIL_BASIC_AUTH_ACKNOWLEDGED=
MAIL_BASIC_AUTH_EXPIRES_AT=
MAIL_NOTIFICATIONS_ENABLED=false
MAIL_RECIPIENT_GATEWAY=
MAIL_RECIPIENT_MOTORSPORT=
MAIL_RECIPIENT_HORSESPORT=
MAIL_MAX_ATTEMPTS=5
MAIL_WORKER_BATCH_SIZE=10
MAIL_WORKER_CRON="*/1 * * * *"

# Do not provision admin users from production environment files. Create them
# interactively or through the approved one-time secure process, then remove
# any temporary provisioning values.
CMS_GATEWAY_ADMIN_EMAIL=
CMS_GATEWAY_ADMIN_PASSWORD=
CMS_GATEWAY_ADMIN_FIRSTNAME=Sarga
CMS_GATEWAY_ADMIN_LASTNAME=Gateway
CMS_MOTORSPORT_ADMIN_EMAIL=
CMS_MOTORSPORT_ADMIN_PASSWORD=
CMS_MOTORSPORT_ADMIN_FIRSTNAME=Sarga
CMS_MOTORSPORT_ADMIN_LASTNAME=Motorsport
CMS_HORSESPORT_ADMIN_EMAIL=
CMS_HORSESPORT_ADMIN_PASSWORD=
CMS_HORSESPORT_ADMIN_FIRSTNAME=Sarga
CMS_HORSESPORT_ADMIN_LASTNAME=Horse Sport
CMS_SHARED_ADMIN_EMAIL=
CMS_SHARED_ADMIN_PASSWORD=
CMS_SHARED_ADMIN_FIRSTNAME=Sarga
CMS_SHARED_ADMIN_LASTNAME=Shared Library

FLAG_NPS=true
FLAG_PROMOTE_EE=true
FLAG_DOC_LINKS=true
