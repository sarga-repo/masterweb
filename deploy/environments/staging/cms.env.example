# Sarga staging shared Strapi CMS runtime environment.
# Copy to /etc/sarga/cms.env on the staging VM, replace every
# REPLACE_WITH_* value through the approved secret channel, then chmod 640.
# Never commit the populated file.

NODE_ENV=production
HOST=127.0.0.1
PORT=1337
PUBLIC_URL=https://staging-cms.sarga.co
PROXY_KOA=true

# Preview is enabled in staging for editorial UAT.
PREVIEW_ENABLED=true
CLIENT_URL=https://staging-motorsport.sarga.co
PREVIEW_URL=https://staging-motorsport.sarga.co
PREVIEW_SECRET=REPLACE_WITH_STAGING_PREVIEW_SECRET
PREVIEW_ALLOWED_ORIGINS=https://staging-motorsport.sarga.co

# Server-to-server Motorsport cache invalidation.
MOTORSPORT_REVALIDATION_SECRET=REPLACE_WITH_STAGING_MOTORSPORT_REVALIDATION_SECRET
MOTORSPORT_FRONTEND_REVALIDATE_URL=http://127.0.0.1:3001/api/revalidate

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sarga_strapi_staging
DATABASE_USERNAME=sarga_cms_staging
DATABASE_PASSWORD=REPLACE_WITH_STAGING_DATABASE_PASSWORD
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

APP_KEYS=REPLACE_WITH_STAGING_APP_KEY_1,REPLACE_WITH_STAGING_APP_KEY_2,REPLACE_WITH_STAGING_APP_KEY_3,REPLACE_WITH_STAGING_APP_KEY_4
API_TOKEN_SALT=REPLACE_WITH_STAGING_API_TOKEN_SALT
ADMIN_JWT_SECRET=REPLACE_WITH_STAGING_ADMIN_JWT_SECRET
TRANSFER_TOKEN_SALT=REPLACE_WITH_STAGING_TRANSFER_TOKEN_SALT
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET
ENCRYPTION_KEY=REPLACE_WITH_STAGING_ENCRYPTION_KEY
CMS_PREVIEW_API_TOKEN_NAME=Read Only

# Never seed demo content on staging. Import the approved CMS snapshot instead.
SEED_DEMO_CONTENT=false
MOTORSPORT_OWNERSHIP_MIGRATION_MODE=off
MOTORSPORT_LEGACY_RETIREMENT_MODE=off
MOTORSPORT_PAGE_SINGLE_TYPES_MIGRATE=false

# Keep mail disabled until the Exchange Online staging UAT is approved.
MAIL_ENABLED=false
MAIL_AUTH_MODE=oauth
MAIL_SMTP_HOST=smtp.office365.com
MAIL_SMTP_PORT=587
MAIL_SMTP_REQUIRE_TLS=true
MAIL_SMTP_USER=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sarga
MAIL_DEFAULT_REPLY_TO=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SMTP_SCOPE=https://outlook.office365.com/.default
MAIL_SMTP_PASSWORD=
MAIL_BASIC_AUTH_ACKNOWLEDGED=
MAIL_BASIC_AUTH_EXPIRES_AT=
MAIL_NOTIFICATIONS_ENABLED=false
MAIL_RECIPIENT_GATEWAY=
MAIL_RECIPIENT_MOTORSPORT=
MAIL_RECIPIENT_HORSESPORT=
MAIL_MAX_ATTEMPTS=5
MAIL_WORKER_BATCH_SIZE=10
MAIL_WORKER_CRON="*/1 * * * *"

# Optional one-time admin provisioning. Remove populated pairs immediately
# after the accounts are created; do not retain them in the runtime file.
CMS_GATEWAY_ADMIN_EMAIL=
CMS_GATEWAY_ADMIN_PASSWORD=
CMS_GATEWAY_ADMIN_FIRSTNAME=Sarga
CMS_GATEWAY_ADMIN_LASTNAME=Gateway
CMS_MOTORSPORT_ADMIN_EMAIL=
CMS_MOTORSPORT_ADMIN_PASSWORD=
CMS_MOTORSPORT_ADMIN_FIRSTNAME=Sarga
CMS_MOTORSPORT_ADMIN_LASTNAME=Motorsport
CMS_HORSESPORT_ADMIN_EMAIL=
CMS_HORSESPORT_ADMIN_PASSWORD=
CMS_HORSESPORT_ADMIN_FIRSTNAME=Sarga
CMS_HORSESPORT_ADMIN_LASTNAME=Horse Sport
CMS_SHARED_ADMIN_EMAIL=
CMS_SHARED_ADMIN_PASSWORD=
CMS_SHARED_ADMIN_FIRSTNAME=Sarga
CMS_SHARED_ADMIN_LASTNAME=Shared Library

FLAG_NPS=true
FLAG_PROMOTE_EE=true
FLAG_DOC_LINKS=true
