# Sarga staging Gateway runtime/build environment.
# Copy to /etc/sarga/gateway.env and replace the token before building.
# NEXT_PUBLIC_* values are embedded by next build.

NODE_ENV=production
NEXT_PUBLIC_SITE_KEY=sarga-gateway
NEXT_PUBLIC_SITE_URL=https://staging.sarga.co
NEXT_PUBLIC_GATEWAY_SITE_URL=https://staging.sarga.co
NEXT_PUBLIC_MOTORSPORT_SITE_URL=https://sargamotorsport.co
NEXT_PUBLIC_HORSESPORT_SITE_URL=https://staging-horsesport.sarga.co
NEXT_PUBLIC_STRAPI_API_URL=https://staging-cms.sarga.co

# Server-only loopback URL; do not expose this as NEXT_PUBLIC_*.
STRAPI_API_URL=http://127.0.0.1:1337
STRAPI_API_URL_INTERNAL=http://127.0.0.1:1337
# Token must be least-privilege for published reads plus form writes used by Gateway.
STRAPI_API_TOKEN=REPLACE_WITH_STAGING_FRONTEND_API_TOKEN
FORM_SUBMISSION_MODE=strapi

# Optional server-side form abuse protection. Leave blank until an approved
# provider integration and site keys are provisioned.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
