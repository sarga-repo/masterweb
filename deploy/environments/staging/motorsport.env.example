# Sarga staging Motorsport runtime/build environment.
# Copy to /etc/sarga/motorsport.env and replace all secret placeholders.
# NEXT_PUBLIC_* values are embedded by next build.

NODE_ENV=production
NEXT_PUBLIC_SITE_KEY=sarga-motorsport
NEXT_PUBLIC_SITE_URL=https://sargamotorsport.co
NEXT_PUBLIC_GATEWAY_SITE_URL=https://staging.sarga.co
NEXT_PUBLIC_MOTORSPORT_SITE_URL=https://sargamotorsport.co
NEXT_PUBLIC_HORSESPORT_SITE_URL=https://staging-horsesport.sarga.co
NEXT_PUBLIC_STRAPI_API_URL=https://staging-cms.sarga.co
NEXT_PUBLIC_HERO_VIDEO_URL=

STRAPI_API_URL=http://127.0.0.1:1337
STRAPI_API_URL_INTERNAL=http://127.0.0.1:1337
# Token must be least-privilege for published reads plus Motorsport form writes.
STRAPI_API_TOKEN=REPLACE_WITH_STAGING_FRONTEND_API_TOKEN
FORM_SUBMISSION_MODE=strapi

# Must match CMS PREVIEW_SECRET and CMS_ADMIN_ORIGIN must be the public CMS URL.
PREVIEW_SECRET=REPLACE_WITH_STAGING_PREVIEW_SECRET
CMS_ADMIN_ORIGIN=https://staging-cms.sarga.co
PREVIEW_ADMIN_ORIGINS=https://staging-cms.sarga.co

# Must match CMS MOTORSPORT_REVALIDATION_SECRET.
MOTORSPORT_REVALIDATION_SECRET=REPLACE_WITH_STAGING_MOTORSPORT_REVALIDATION_SECRET

# Empty values disable custom ticket schemes and iframe embeds by default.
TICKETING_DEEP_LINK_SCHEMES=
TICKETING_EMBED_ALLOWLIST=
