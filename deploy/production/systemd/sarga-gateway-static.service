[Unit]
Description=Sarga.co static Gateway website frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sarga
Group=sarga
WorkingDirectory=/srv/sarga-website/frontend-gateway-static
EnvironmentFile=/etc/sarga/gateway-static.env
ExecStart=/usr/local/bin/pnpm exec next start --hostname 127.0.0.1 --port 3005
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
