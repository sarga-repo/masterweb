[Unit]
Description=Sarga.co gateway frontend
After=network-online.target sarga-cms.service
Wants=network-online.target

[Service]
Type=simple
User=sarga
Group=sarga
WorkingDirectory=/srv/sarga-website/frontend-gateway
EnvironmentFile=/etc/sarga/gateway.env
ExecStart=/usr/local/bin/pnpm exec next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
