[Unit]
Description=Sarga Horse Sport frontend
After=network-online.target sarga-cms.service
Wants=network-online.target

[Service]
Type=simple
User=sarga
Group=sarga
WorkingDirectory=/srv/sarga-website/frontend-horsesport
EnvironmentFile=/etc/sarga/horsesport.env
ExecStart=/usr/local/bin/pnpm exec next start --hostname 127.0.0.1 --port 3002
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
