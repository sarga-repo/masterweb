        "launchTarget": "string",
        "order": "integer",
        "relatedArticles": "relation:newsArticle",
        "relatedEvents": "relation:event",
        "seo": "component:seo"
      }
    },
    "newsArticle": {
      "fields": {
        "title": "string",
        "slug": "uid",
        "excerpt": "text",
        "body": "richtext_or_blocks",
        "coverImage": "media",
        "category": [
          "news",
          "publication",
          "press-release",
          "report",
          "magazine"
        ],
        "publishedDate": "date",
        "isHotTopic": "boolean",
        "author": "string",
        "relatedBusinesses": "relation:ecosystemBusiness",
        "seo": "component:seo",
        "publishedAt": "datetime"
      }
    },
    "event": {
      "fields": {
        "title": "string",
        "slug": "uid",
        "description": "richtext",
        "eventDate": "datetime",
        "endDate": "datetime",
        "venue": "string",
        "coverImage": "media",
        "business": "relation:ecosystemBusiness",
        "ticketCtaLabel": "string",
        "ticketUrl": "string",
        "ticketIntegrationType": [
          "redirect",
          "deepLink",
          "embed"
        ],
        "embedCode": "text",
        "eventStatus": [
          "upcoming",
          "live",
          "past",
          "hidden"
        ],
        "seo": "component:seo"
      }
    },
    "timelineItem": {
      "fields": {
        "year": "string",
        "label": "string",
        "title": "string",
        "description": "text",
        "image": "media",
        "order": "integer"
      }
    },
    "leadershipPerson": {
      "fields": {
        "name": "string",
        "role": "string",
