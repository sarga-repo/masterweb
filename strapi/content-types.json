        "portrait": "media",
        "biography": "richtext",
        "order": "integer",
        "publishedAt": "datetime"
      }
    },
    "inquirySubmission": {
      "fields": {
        "name": "string",
        "email": "email",
        "phone": "string",
        "company": "string",
        "inquiryType": "enum",
        "message": "text",
        "sourcePage": "string",
        "submittedAt": "datetime",
        "status": "enum",
        "internalNotes": "text"
      }
    },
    "newsletterSubscription": {
      "fields": {
        "email": "email",
        "sourcePage": "string",
        "consent": "boolean",
        "subscribedAt": "datetime",
        "status": "enum"
      }
    }
  },
  "components": {
    "seo": {
      "fields": {
        "metaTitle": "string",
        "metaDescription": "text",
        "ogTitle": "string",
        "ogDescription": "text",
        "ogImage": "media",
        "canonicalUrl": "string",
        "noIndex": "boolean"
      }
    }
  },
  "_notes": [
    "businessStatus/eventStatus were renamed from 'status': 'status' is a reserved attribute name in Strapi v5 (document draft/publish state)."
  ]
}