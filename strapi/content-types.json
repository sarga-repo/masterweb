{
  "singleTypes": {
    "siteSettings": {
      "fields": {
        "siteName": "string",
        "legalCompanyName": "string",
        "logo": "media",
        "footerLogo": "media",
        "primaryEmail": "email",
        "phone": "string",
        "address": "richtext",
        "socialLinks": "repeatableComponent",
        "defaultOgImage": "media"
      }
    },
    "homepage": {
      "fields": {
        "heroEyebrow": "string",
        "heroTitle": "string",
        "heroDescription": "richtext",
        "heroImage": "media",
        "heroImageMobile": "media",
        "primaryCtaLabel": "string",
        "primaryCtaUrl": "string",
        "secondaryCtaLabel": "string",
        "secondaryCtaUrl": "string",
        "aboutSummaryTitle": "string",
        "aboutSummaryBody": "richtext",
        "featuredBusinesses": "relation:ecosystemBusiness",
        "featuredArticles": "relation:newsArticle",
        "featuredEvents": "relation:event",
        "seo": "component:seo"
      }
    }
  },
  "collectionTypes": {
    "ecosystemBusiness": {
      "fields": {
        "name": "string",
        "slug": "uid",
        "pillar": [
          "sports",
          "venue",
          "media",
          "technology",
          "festival",
          "other"
        ],
        "shortDescription": "text",
        "overview": "richtext",
