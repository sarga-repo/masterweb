{
  "singleTypes": {
    "siteSettings": {
      "fields": {
        "siteName": "string",
        "legalCompanyName": "string",
        "logo": "media",
        "footerLogo": "media",
        "primaryEmail": "email",
        "phone": "string",
        "address": "richtext",
        "socialLinks": "repeatableComponent",
        "defaultOgImage": "media"
      }
    },
    "homepage": {
      "fields": {
        "heroEyebrow": "string",
        "heroTitle": "string",
        "heroDescription": "richtext",
        "heroImage": "media",
        "heroImageMobile": "media",
        "primaryCtaLabel": "string",
        "primaryCtaUrl": "string",
        "secondaryCtaLabel": "string",
        "secondaryCtaUrl": "string",
        "aboutSummaryTitle": "string",
        "aboutSummaryBody": "richtext",
        "featuredBusinesses": "relation:ecosystemBusiness",
        "featuredArticles": "relation:newsArticle",
        "featuredEvents": "relation:event",
        "seo": "component:seo"
      }
    }
  },
  "collectionTypes": {
    "site": {
      "fields": {
        "name": "string",
        "slug": "uid",
        "baseUrl": "string",
        "description": "text",
        "logo": "media",
        "favicon": "media",
        "themeKey": "string",
        "isActive": "boolean"
      }
    },
    "ecosystemBusiness": {
      "fields": {
        "name": "string",
        "slug": "uid",
        "pillar": ["sports", "venue", "media", "technology", "festival", "other"],
        "shortDescription": "text",
        "overview": "richtext",
        "heroImage": "media",
        "cardImage": "media",
        "logo": "media",
        "ctaLabel": "string",
        "ctaUrl": "string",
        "businessStatus": ["active", "comingSoon", "hidden"],
        "launchTarget": "string",
        "order": "integer",
        "siteScope": ["gateway", "motorsport", "shared", "hidden"],
        "dedicatedSiteUrl": "string",
        "relatedArticles": "relation:newsArticle",
        "relatedEvents": "relation:event",
        "seo": "component:seo"
      }
    },
    "newsArticle": {
      "fields": {
        "title": "string",
        "slug": "uid",
        "excerpt": "text",
        "body": "richtext_or_blocks",
        "coverImage": "media",
        "category": [
          "news",
          "publication",
          "press-release",
          "report",
          "magazine",
          "race-report",
          "announcement",
          "lifestyle",
          "community",
          "media"
        ],
        "publishedDate": "date",
        "isHotTopic": "boolean",
        "author": "string",
        "relatedBusinesses": "relation:ecosystemBusiness",
        "relatedEvent": "relation:event",
        "siteScope": ["gateway", "motorsport", "shared", "hidden"],
        "sites": "relation:site",
        "showOnGateway": "boolean",
        "showOnMotorsport": "boolean",
        "featuredOnGateway": "boolean",
        "featuredOnMotorsport": "boolean",
        "seo": "component:seo",
        "publishedAt": "datetime"
      }
    },
    "event": {
      "fields": {
        "title": "string",
        "slug": "uid",
        "description": "richtext",
        "eventDate": "datetime",
        "endDate": "datetime",
        "venue": "string",
        "coverImage": "media",
        "business": "relation:ecosystemBusiness",
        "ticketCtaLabel": "string",
        "ticketUrl": "string",
        "ticketIntegrationType": ["redirect", "deepLink", "embed"],
        "embedCode": "text",
        "embedUrl": "string",
        "eventStatus": [
          "upcoming",
          "live",
          "past",
          "hidden",
          "announced",
          "ticketsOpen",
          "soldOut",
          "completed",
          "cancelled"
        ],
        "siteScope": ["gateway", "motorsport", "shared", "hidden"],
        "sites": "relation:site",
        "showOnGateway": "boolean",
        "showOnMotorsport": "boolean",
        "racingCategory": "string",
        "seriesName": "string",
        "venueAddress": "text",
        "circuitName": "string",
        "schedule": "repeatableComponent:eventSession",
        "heroMedia": "media",
        "gallery": "media",
        "broadcastUrl": "string",
        "ticketCtas": "relation:ticketCta",
        "sponsors": "relation:partner",
        "seo": "component:seo"
      }
    },
    "ticketCta": {
      "fields": {
        "title": "string",
        "label": "string",
        "provider": "string",
        "ctaType": ["redirect", "deepLink", "embed"],
        "url": "string",
        "embedCode": "text",
        "embedConfigJson": "json",
        "trackingParams": "json",
        "activeFrom": "datetime",
        "activeUntil": "datetime",
        "isActive": "boolean",
        "siteScope": ["gateway", "motorsport", "shared", "hidden"],
        "sites": "relation:site",
        "relatedEvent": "relation:event"
      }
    },
    "partner": {
      "fields": {
        "name": "string",
        "slug": "uid",
        "logo": "media",
        "websiteUrl": "string",
        "partnerType": [
          "sponsor",
          "technical",
          "media",
          "broadcast",
          "government",
          "community",
          "other"
        ],
        "siteScope": ["gateway", "motorsport", "shared", "hidden"],
        "sites": "relation:site",
        "sortOrder": "integer",
        "isActive": "boolean"
      }
    },
    "mediaGallery": {
      "fields": {
        "title": "string",
        "slug": "uid",
        "description": "text",
        "mediaItems": "media",
        "relatedEvent": "relation:event",
        "siteScope": ["gateway", "motorsport", "shared", "hidden"],
        "sites": "relation:site"
      }
    },
    "timelineItem": {
      "fields": {
        "year": "string",
        "label": "string",
        "title": "string",
        "description": "text",
        "image": "media",
        "order": "integer"
      }
    },
    "leadershipPerson": {
      "fields": {
        "name": "string",
        "role": "string",
        "group": ["board", "executive"],
        "portrait": "media",
        "biography": "richtext",
        "order": "integer",
        "publishedAt": "datetime"
      }
    },
    "inquirySubmission": {
      "fields": {
        "name": "string",
        "email": "email",
        "phone": "string",
        "company": "string",
        "inquiryType": "enum",
        "message": "text",
        "sourcePage": "string",
        "submittedAt": "datetime",
        "status": "enum",
        "internalNotes": "text"
      }
    },
    "newsletterSubscription": {
      "fields": {
        "email": "email",
        "sourcePage": "string",
        "consent": "boolean",
        "subscribedAt": "datetime",
        "status": "enum"
      }
    }
  },
  "components": {
    "seo": {
      "fields": {
        "metaTitle": "string",
        "metaDescription": "text",
        "ogTitle": "string",
        "ogDescription": "text",
        "ogImage": "media",
        "canonicalUrl": "string",
        "noIndex": "boolean"
      }
    },
    "keyHighlight": {
      "fields": {
        "label": "string",
        "title": "string",
        "description": "text"
      }
    },
    "eventSession": {
      "fields": {
        "label": "string",
        "day": "string",
        "startTime": "datetime",
        "endTime": "datetime",
        "description": "text"
      }
    }
  },
  "_notes": [
    "businessStatus/eventStatus were renamed from 'status': 'status' is a reserved attribute name in Strapi v5 (document draft/publish state).",
    "Phase 2 multisite: siteScope enum (gateway|motorsport|shared|hidden) + optional many-to-many 'sites' relation added to event, news-article, ticket-cta, partner, media-gallery, and ecosystem-business. showOnGateway/showOnMotorsport booleans drive cross-site teasers.",
    "eventStatus and newsArticle.category enums were extended (not replaced) with motorsport values to preserve backward compatibility with existing gateway content.",
    "event.ticketCtas <-> ticketCta.relatedEvent is a single bidirectional one-to-many relation (one event, many ticket CTAs), replacing the singular 'ticketCta' field named in the spec to avoid a duplicate relation.",
    "This file mirrors the Strapi schemas under cms/src/api and cms/src/components; it is documentation, not the source of truth."
  ]
}
